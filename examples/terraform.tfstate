{
  "version": 4,
  "terraform_version": "1.6.0",
  "resources": [
    {
      "mode": "managed",
      "type": "azurerm_resource_group",
      "name": "rg",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "rg-example",
            "location": "westeurope",
            "tags": {
              "owner": "christoph",
              "project": "state-analyzer"
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "random_string",
      "name": "suffix",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "abc123",
            "length": 6,
            "result": "abc123"
          }
        }
      ]
    }
  ]
}