{
  "version": 4,
  "terraform_version": "1.6.0",
  "resources": [
    {
      "mode": "managed",
      "type": "azurerm_storage_account",
      "name": "example",
      "provider": "provider[\"registry.terraform.io/hashicorp/azurerm\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "examplestorage123",
            "location": "westeurope",
            "account_tier": "Standard",
            "account_replication_type": "LRS",
            "tags": {
              "environment": "dev"
            }
          }
        }
      ]
    }
  ]
}