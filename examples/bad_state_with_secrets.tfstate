{
  "version": 4,
  "terraform_version": "1.6.0",
  "resources": [
    {
      "mode": "managed",
      "type": "azurerm_key_vault_secret",
      "name": "admin_password",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "adminPassword",
            "value": "SuperSecret123!",
            "content_type": "password"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "azurerm_storage_account",
      "name": "example",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "examplestorage123",
            "primary_connection_string": "DefaultEndpointsProtocol=https;AccountName=examplestorage123;AccountKey=abcd1234abcd1234abcd1234abcd1234==;",
            "primary_access_key": "abcd1234abcd1234abcd1234abcd1234=="
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "tls_private_key",
      "name": "ssh_key",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "private_key_pem": "-----BEGIN PRIVATE KEY-----\nMIIBVwIBADANBgkqhkiG9w0BAQEFAASCAT8wggE7AgEAAkEAuFakeKeyFakeKey\n-----END PRIVATE KEY-----"
          }
        }
      ]
    }
  ]
}